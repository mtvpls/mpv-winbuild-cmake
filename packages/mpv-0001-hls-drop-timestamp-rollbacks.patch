+// A stream must fall this far behind its own watermark before we treat it as a
+// different (ad) timeline. 8s sits too close to MPEG-TS reorder distance and
+// A/V skew, and fires several seconds before the ad actually starts.
+#define ROLLBACK_ENTER_SEC 20.0
+// Keyframe/preroll overlap tolerated when the original timeline returns.
+#define ROLLBACK_RECOVER_SEC 1.0
+// libavformat can still hand over a few pre-seek packets after a seek.
+#define ROLLBACK_SEEK_GRACE_PACKETS 100
+// One full 33-bit MPEG-TS timestamp period, in seconds (~26.5h).
+#define TS_WRAP_SEC (8589934592.0 / 90000.0)
+// Past this much of the foreign timeline it is not an ad break any more, it is
+// a real timeline change, and dropping forever would hang playback for good.
+#define ROLLBACK_GIVEUP_SEC 300.0
+
+// libavformat's MPEG-TS wraparound correction assumes timestamps only ever move
+// forward, so an ad segment whose own PTS starts near zero is handed to us one
+// whole period *ahead* of the content instead of behind it. Fold it back down,
+// otherwise the rollback reads as a jump forward and the ad's timeline gets
+// adopted as the reference — which then drops the returning content instead.
+static double ts_rollback_unwrap(double pts)
+{
+    while (pts >= TS_WRAP_SEC / 2)
+        pts -= TS_WRAP_SEC;
+    return pts;
+}
+
+static void reset_ts_rollback_state(lavf_priv_t *priv)
+{
+    for (int n = 0; n < priv->num_streams; n++) {
+        struct stream_info *info = priv->streams[n];
+        info->rollback_highest_pts = MP_NOPTS_VALUE;
+        info->rollback_rolled_back = false;
+        info->rollback_recovered = false;
+    }
+    priv->rollback_dropping = false;
+    priv->rollback_floor_pts = MP_NOPTS_VALUE;
+    priv->rollback_alt_start_pts = MP_NOPTS_VALUE;
+    priv->rollback_num_rolled_back = 0;
+    priv->rollback_need_keyframe = false;
+    priv->rollback_seek_grace = ROLLBACK_SEEK_GRACE_PACKETS;
+}
+
+static void ts_rollback_mark(lavf_priv_t *priv, struct stream_info *info)
+{
+    if (!info->rollback_rolled_back) {
+        info->rollback_rolled_back = true;
+        priv->rollback_num_rolled_back += 1;
+    }
+    info->rollback_recovered = false;
+}
+
+// True when the packet belongs to an old timeline (an inserted ad) and has to
+// be withheld from the demux queue.
+static bool ts_rollback_should_drop(struct demuxer *demux,
+                                    struct stream_info *info,
+                                    double pts, bool keyframe)
+{
+    lavf_priv_t *priv = demux->priv;
+
+    if (pts == MP_NOPTS_VALUE)
+        return priv->rollback_dropping || priv->rollback_need_keyframe;
+
+    pts = ts_rollback_unwrap(pts);
+
+    // A seek always clears the state, so no drop session can be active here.
+    if (priv->rollback_seek_grace > 0) {
+        priv->rollback_seek_grace -= 1;
+        info->rollback_highest_pts =
+            MP_PTS_MAX(info->rollback_highest_pts, pts);
+        return false;
+    }
+
+    if (priv->rollback_dropping) {
+        if (pts + ROLLBACK_RECOVER_SEC < priv->rollback_floor_pts) {
+            if (priv->rollback_alt_start_pts == MP_NOPTS_VALUE)
+                priv->rollback_alt_start_pts = pts;
+            if (pts > priv->rollback_alt_start_pts + ROLLBACK_GIVEUP_SEC) {
+                MP_WARN(demux, "Timestamp rollback ran for %f s, giving up and "
+                        "adopting the new timeline\n",
+                        pts - priv->rollback_alt_start_pts);
+                reset_ts_rollback_state(priv);
+                priv->rollback_seek_grace = 0;
+                priv->rollback_need_keyframe = true;
+                return true;
+            }
+            ts_rollback_mark(priv, info);
+            return true;
+        }
+
+        if (info->rollback_rolled_back) {
+            // Restarting mid-GOP leaves the decoder error-concealing a broken
+            // reference chain, so wait for a keyframe before reopening.
+            if (!keyframe)
+                return true;
+            info->rollback_rolled_back = false;
+            info->rollback_recovered = true;
+            priv->rollback_num_rolled_back -= 1;
+            info->rollback_highest_pts =
+                MP_PTS_MAX(info->rollback_highest_pts, pts);
+            if (priv->rollback_num_rolled_back == 0) {
+                MP_WARN(demux, "Timestamp rollback recovered: %f >= %f\n",
+                        pts, priv->rollback_floor_pts);
+                priv->rollback_dropping = false;
+                priv->rollback_floor_pts = MP_NOPTS_VALUE;
+                priv->rollback_alt_start_pts = MP_NOPTS_VALUE;
+                priv->rollback_need_keyframe = false;
+                for (int n = 0; n < priv->num_streams; n++)
+                    priv->streams[n]->rollback_recovered = false;
+            }
+            return false;
+        }
+
+        if (info->rollback_recovered) {
+            // Already restarted: keep feeding this track so the decoder is not
+            // starved while sibling tracks are still catching up.
+            info->rollback_highest_pts =
+                MP_PTS_MAX(info->rollback_highest_pts, pts);
+            return false;
+        }
+
+        // Never rolled back this session, typically continuous ad audio.
+        return true;
+    }
+
+    if (priv->rollback_need_keyframe) {
+        if (!keyframe)
+            return true;
+        priv->rollback_need_keyframe = false;
+    } else if (info->rollback_highest_pts != MP_NOPTS_VALUE &&
+               pts + ROLLBACK_ENTER_SEC < info->rollback_highest_pts)
+    {
+        // Compare against this stream's own watermark only. A watermark shared
+        // across streams false-fires when video readahead runs ahead of audio.
+        MP_WARN(demux, "Dropping timestamp rollback: %f -> %f\n",
+                info->rollback_highest_pts, pts);
+        priv->rollback_dropping = true;
+        priv->rollback_floor_pts = info->rollback_highest_pts;
+        priv->rollback_need_keyframe = true;
+        ts_rollback_mark(priv, info);
+        return true;
+    }
+
+    info->rollback_highest_pts = MP_PTS_MAX(info->rollback_highest_pts, pts);
+    return false;
+}
